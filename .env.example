# Router connection. Enable "Allow access for applications" in the FRITZ!Box.
FRITZ_HOST=fritz.box
FRITZ_USERNAME=
# Prefer a private file containing only the router password.
FRITZ_PASSWORD_FILE=/absolute/path/to/private/fritzbox-password
# Alternatively set FRITZ_PASSWORD in the MCP host's environment.
# FRITZ_PASSWORD=

# Browser fallback for settings without documented API actions.
FRITZ_UI_URL=https://fritz.box
